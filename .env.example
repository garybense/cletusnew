# Server-side NVIDIA NIM API key & optional endpoint overrides for Cletus inference
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ASR_URL=
NVIDIA_TTS_URL=
NVIDIA_VIDEO_URL=

# Optional PostgreSQL connection string (falls back to embedded PGLite when unset)
DATABASE_URL=

# Authentication feature flag
VITE_AUTH_ENABLED=false

# Better Auth configuration (only needed if VITE_AUTH_ENABLED=true)
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Optional public hostname for PWA manifest/head tags
VITE_PUBLIC_HOSTNAME=
